@page "{id:int}"
@model Tarea3CRUD.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <p class="text-danger fw-bold">¿Estás seguro de que deseas eliminar permanentemente este producto?</p>
                    
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item"><strong>ID:</strong> #@Model.Product.Id</li>
                        <li class="list-group-item"><strong>Nombre:</strong> @Model.Product.Name</li>
                        <li class="list-group-item"><strong>Categoría:</strong> @Model.Product.Category</li>
                        <li class="list-group-item"><strong>Precio:</strong> @Model.Product.Price.ToString("C")</li>
                        <li class="list-group-item"><strong>Stock:</strong> @Model.Product.Stock</li>
                    </ul>

                    <form method="post" class="d-flex justify-content-between">
                        <input type="hidden" asp-for="Product.Id" />
                        <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger">Eliminar Producto</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
